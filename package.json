{
  "name": "another-git",
  "version": "1.0.0",
  "description": "Another Git desktop application",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/style.css",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "dev": "vite",
    "dev:tauri-frontend": "vite --config vite.tauri.config.ts --port 1420 --strictPort",
    "build": "tsc && tsc --declaration --emitDeclarationOnly --outDir dist && vite build",
    "build:tauri-frontend": "vite build --config vite.tauri.config.ts --outDir dist-tauri",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "typecheck": "tsc --noEmit",
    "lint": "NODE_OPTIONS=\"-r ./scripts/eslint-ts7-compat.cjs\" eslint src",
    "format": "prettier --write \"src/**/*.{ts,tsx,scss,css,json}\""
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@phosphor-icons/web": "^2.1.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "prettier": "^3.4.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sass": "^1.83.0",
    "typescript": "^7.0.2",
    "typescript6": "npm:typescript@^6.0.3",
    "vite": "^6.0.7"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "monaco-editor": "0.55.1",
    "react-redux": "^9.3.0"
  }
}
